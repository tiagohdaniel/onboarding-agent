# Copie para .env (cp .env.example .env). O .env nunca vai pro git.

# Banco — "localhost" quando rodar fora do Docker (ex: pytest no host).
# Dentro do compose, o docker-compose.yml sobrescreve com o host "db".
DATABASE_URL=postgresql://onboarding:onboarding@localhost:5432/onboarding

# LLM (Fase 1)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Langfuse Cloud (Fase 2)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
